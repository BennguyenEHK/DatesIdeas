# Neon Lakebase Postgres. Server-only — never expose this to the browser.
DATABASE_URL=

# Cloudflare Realtime TURN. Server-only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Neon Object Storage, for the photo booth's QR download links. Server-only.
#
# Optional: without these the booth still works and only the two QR modes are
# unavailable — the heart download never touches a server at all.
#
# Every one of these is a secret. None may ever carry a NEXT_PUBLIC_ prefix:
# that prefix compiles the value into the JavaScript sent to the browser, and
# these keys grant write access to the bucket.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=auto
NEON_STORAGE_BUCKET=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Web Push (VAPID), for the daily snap notification. Server-only.
#
# Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Regenerating these invalidates every existing subscription, so both phones
# would have to switch notifications back on. Generate once and keep them.
#
# The public key is not a secret -- the browser needs it to subscribe. It still
# has no NEXT_PUBLIC_ prefix: it reaches the client through an API route, so
# nothing here is ever compiled into the JavaScript bundle. The private key is
# the one that actually signs pushes, and it is an ordinary secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
