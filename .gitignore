# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the templates carry no values and must be committed, or a fresh
# clone has no way to know which variables the app needs. Both are named
# explicitly rather than with a wildcard: a rule broad enough to re-admit
# every "example" file is one typo away from committing a real secret.
!.env.local.example
!helper/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dispatch worker logs
.claude/dispatch-runs/
*.stackdump

# Screenshots dropped in the project root while reporting a bug. They are
# photographs of two people's faces and this repository is public.
/Screenshot*.png
