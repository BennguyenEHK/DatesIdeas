# Shared secret used to authenticate the app and tunnel registration; use a long random value.
HELPER_SECRET=replace-with-a-long-random-secret
# Public HTTPS URL of the deployed DatesIdea app, without a trailing slash.
APP_URL=https://your-app.vercel.app
# Leave UNSET for a quick tunnel: the helper starts cloudflared and discovers
# its own hostname, which is the only way this survives a reboot unattended.
# Set it only for a NAMED tunnel with a stable hostname.
# TUNNEL_URL=https://karaoke.example.com
# Exact deployed browser origin permitted by CORS; leave unset to block browser cross-origin access.
ALLOWED_ORIGIN=https://your-app.vercel.app
