{
  "name": "FestiBooth",
  "short_name": "FestiBooth",
  "description": "A private room for two, and the album it fills.",
  "start_url": "/album",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080b1c",
  "theme_color": "#080b1c",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Take a snap", "url": "/snap", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["image/*", "video/*"] }
      ]
    }
  }
}
